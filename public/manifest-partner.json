{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Elyanivery Partner - Merchant & Kitchen",
  "short_name": "Partner Hub",
  "description": "Live incoming order manager, digital menu editor, sales analytics, and kitchen display.",
  "id": "/partner?source=pwa",
  "start_url": "/partner",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#3B82F6",
  "lang": "en-US",
  "dir": "auto",
  "categories": [
    "business",
    "productivity",
    "shopping"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-partner.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Partner Kitchen Orders Screen"
    },
    {
      "src": "/screenshots/desktop-dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Partner Store Dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "Kitchen Orders",
      "short_name": "Orders",
      "description": "View live incoming orders",
      "url": "/partner",
      "icons": [
        {
          "src": "/icons/shortcut-partner.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Menu Editor",
      "short_name": "Menu",
      "description": "Manage catalog and prices",
      "url": "/partner",
      "icons": [
        {
          "src": "/icons/shortcut-partner.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "navigate-new"
    ]
  },
  "file_handlers": [
    {
      "action": "/partner",
      "name": "Menu Import",
      "icons": [
        {
          "src": "/icons/shortcut-partner.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ],
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+elyanivery",
      "url": "/partner?action=%s"
    }
  ],
  "share_target": {
    "action": "/partner",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Kitchen Live",
      "short_name": "Kitchen",
      "description": "Pending kitchen orders",
      "tag": "partner-orders",
      "template": "widget-orders",
      "ms_ac_template": "/widgets/orders.json",
      "data": "/api/partner/orders",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/widget-order.png",
          "sizes": "400x200",
          "label": "Partner Kitchen Widget"
        }
      ]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "/support"
  },
  "scope_extensions": [
    {
      "origin": "*.elyanivery.com"
    },
    {
      "origin": "*.onrender.com"
    }
  ]
}
